{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Zeus",
  "version": "0.1.0",
  "identifier": "dev.verne.zeus.desktop",
  "build": { "frontendDist": "ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [{
      "label": "main", "create": false, "title": "Zeus", "width": 1240, "height": 840,
      "minWidth": 640, "minHeight": 480, "dragDropEnabled": false
    }],
    "security": {
      "capabilities": ["workspace"],
      "csp": "default-src 'none'; script-src 'self'; style-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self'; base-uri 'none'; form-action 'none'; object-src 'none'; frame-src 'none'"
    }
  },
  "bundle": { "active": false, "icon": ["icons/icon.ico", "icons/icon.png"] }
}
