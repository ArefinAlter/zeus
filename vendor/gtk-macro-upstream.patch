+#[cfg(test)]
+mod diagnostic_tests {
+    use super::Closure;
+
+    #[test]
+    fn invalid_captures_and_async_closures_return_diagnostics() {
+        for (input, expected) in [
+            ("@unknown value => move || {}", "Unknown keyword"),
+            ("@strong self => move || {}", "Can't use `self`"),
+            ("@strong value.field => move || {}", "Field accesses"),
+            ("async move || {}", "Async closure not allowed"),
+            ("@strong value => || {}", "Closure with captures"),
+        ] {
+            let Err(error) = syn::parse_str::<Closure>(input) else {
+                panic!("invalid closure was accepted: {input}");
+            };
+            assert!(error.to_string().contains(expected), "{error}");
+        }
+        assert!(syn::parse_str::<Closure>("@strong value => move || {}").is_ok());
+    }
+
+    #[test]
+    fn duplicate_watch_reports_both_capture_locations() {
+        let Err(error) = syn::parse_str::<Closure>("@watch first, @watch second => move || {}")
+        else {
+            panic!("two watch captures were accepted");
+        };
+        let diagnostics: Vec<_> = error.into_iter().map(|error| error.to_string()).collect();
+        assert_eq!(diagnostics.len(), 2);
+        assert!(diagnostics[0].contains("Only one `@watch`"));
+        assert!(diagnostics[1].contains("Previous `@watch`"));
+    }
+}
