# Zeus pre-alpha (/opt/zeus-prealpha). The host's nginx terminates TLS, rate-limits and adds headers; everything else
# is the compose project's edge container on 127.0.0.1:18540 (static client, /api/ bridge, /svc/ service).
# Installed as /etc/nginx/sites-available/zeus-prealpha with a symlink in sites-enabled.

limit_req_zone $binary_remote_addr zone=zeus_prealpha_read:10m rate=20r/s;
limit_req_zone $binary_remote_addr zone=zeus_prealpha_write:10m rate=60r/m;
limit_req_zone $binary_remote_addr zone=zeus_prealpha_session:10m rate=12r/m;

server {
    listen 80;
    listen [::]:80;
    server_name zeus.103.191.50.32.sslip.io;
    location /.well-known/acme-challenge/ { root /var/www/html; }
    location / { return 301 https://$host$request_uri; }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name zeus.103.191.50.32.sslip.io;

    ssl_certificate /etc/letsencrypt/live/zeus.103.191.50.32.sslip.io/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/zeus.103.191.50.32.sslip.io/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    client_max_body_size 600k;
    limit_req_status 429;

    # No HSTS on an sslip.io name. The page's CSP comes from the edge container.
    add_header X-Robots-Tag "noindex, nofollow" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()" always;
    add_header Cross-Origin-Opener-Policy "same-origin" always;

    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto https;
    proxy_read_timeout 60s;

    location = /api/v1/session {
        limit_req zone=zeus_prealpha_session burst=6 nodelay;
        proxy_pass http://127.0.0.1:18540;
    }

    location ~ ^/(api/v1/links/|api/v1/jobs/[^/]+/control|svc/v1/sitegrab/|svc/v1/links/check|svc/v1/approvals) {
        limit_req zone=zeus_prealpha_write burst=30 nodelay;
        proxy_pass http://127.0.0.1:18540;
    }

    location /api/ {
        limit_req zone=zeus_prealpha_read burst=60 nodelay;
        proxy_pass http://127.0.0.1:18540;
    }

    location /svc/ {
        limit_req zone=zeus_prealpha_read burst=60 nodelay;
        proxy_pass http://127.0.0.1:18540;
    }

    location / {
        limit_req zone=zeus_prealpha_read burst=100 nodelay;
        proxy_pass http://127.0.0.1:18540;
    }
}
